{
  "name": "actor-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "init:local": "node scripts/init-local.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "node --env-file=.env scripts/dotnet.mjs run --project backend/ActorWebsite.Api --launch-profile http",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "node --env-file=.env scripts/dotnet.mjs ef database update --project backend/ActorWebsite.Api",
    "tools:restore": "dotnet tool restore",
    "build:web": "npm --prefix frontend run build",
    "build:api": "dotnet build ActorWebsite.slnx --configuration Release --disable-build-servers -m:1",
    "lint:web": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check",
    "format:api": "dotnet format whitespace backend --folder --exclude ActorWebsite.Api/Data/Migrations ActorWebsite.Api/bin ActorWebsite.Api/obj ActorWebsite.Api.Tests/bin ActorWebsite.Api.Tests/obj",
    "format:api:check": "npm run format:api -- --verify-no-changes",
    "check": "npm run format:check && npm run lint:web && npm run test:web && npm run build:web && npm run build:api",
    "test:web": "npm --prefix frontend test",
    "admin:create": "node --env-file=.env scripts/dotnet.mjs run --project backend/ActorWebsite.Api --no-launch-profile -- --create-admin",
    "admin:reset-password": "node --env-file=.env scripts/dotnet.mjs run --project backend/ActorWebsite.Api --no-launch-profile -- --reset-admin-password",
    "test:api": "node --env-file=.env scripts/test-api.mjs"
  }
}
